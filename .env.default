SALPUB_HOSTNAME=http://localhost

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_HOSTNAME=${SALPUB_HOSTNAME}
KC_HTTP_RELATIVE_PATH=/auth

KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

POSTGRES_DB=${KC_DB_URL_DATABASE}
POSTGRES_USER=${KC_DB_USERNAME}
POSTGRES_PASSWORD=${KC_DB_PASSWORD}

# OIDC client for cmd/server, created in the sal realm on import (docker/keycloak/sal.json).
# The Go server reads the same variables, so both sides stay in sync.
KEYCLOAK_CLIENT_ID=sal-pub
KEYCLOAK_CLIENT_SECRET=change-this-client-secret
REDIRECT_URL=http://localhost:8000/auth/callback

# Keycloak identity providers, substituted into docker/keycloak/sal.json on realm import.
# Where to create these credentials: see docker/keycloak/README.md
IDP_MICROSOFT_CLIENT_ID=
IDP_MICROSOFT_TENANT_ID=
IDP_MICROSOFT_CLIENT_SECRET=
IDP_GITHUB_CLIENT_ID=
IDP_GITHUB_CLIENT_SECRET=
IDP_GOOGLE_CLIENT_ID=
IDP_GOOGLE_CLIENT_SECRET=
IDP_GITLAB_CLIENT_ID=
IDP_GITLAB_CLIENT_SECRET=
