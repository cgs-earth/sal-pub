SALPUB_HOSTNAME=http://localhost

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=true
KC_HTTP_RELATIVE_PATH=/auth
# A full URL, including the relative path, as required by KC_HOSTNAME_BACKCHANNEL_DYNAMIC.
KC_HOSTNAME=${SALPUB_HOSTNAME}${KC_HTTP_RELATIVE_PATH}
# Let containers on the compose network (sal-pub) use Keycloak's internal URL
# for token/JWKS calls while browsers keep using the public one.
KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true

KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

POSTGRES_DB=${KC_DB_URL_DATABASE}
POSTGRES_USER=${KC_DB_USERNAME}
POSTGRES_PASSWORD=${KC_DB_PASSWORD}

# OIDC client for cmd/server, created in the sal realm on import (docker/keycloak/sal.json).
# The Go server reads the same variables, so both sides stay in sync.
# The callback must not be under /auth, which Caddy routes to Keycloak.
KEYCLOAK_CLIENT_ID=sal-pub
KEYCLOAK_CLIENT_SECRET=change-this-client-secret
REDIRECT_URL=${SALPUB_HOSTNAME}/oauth/callback

# DATABASE_URL are only used by `go run`; docker-compose.yml
# overrides them for the container. The salpub database is created by
# docker/postgres/01-salpub.sql on first start.
DATABASE_URL=postgres://keycloak:keycloak@localhost:5432/salpub?sslmode=disable
# Cookie signing key. Generate with: openssl rand -hex 32. If empty, a random
# key is used and sessions end when the server restarts.
SESSION_SECRET=
# DEVELOPMENT ONLY: set to true when Keycloak is served over HTTPS by Caddy's
# local CA. Affects calls to Keycloak only, never federation traffic.
OIDC_INSECURE_SKIP_VERIFY=false

# Keycloak identity providers, substituted into docker/keycloak/sal.json on realm import.
# Where to create these credentials: see docker/keycloak/README.md
IDP_MICROSOFT_CLIENT_ID=
IDP_MICROSOFT_TENANT_ID=
IDP_MICROSOFT_CLIENT_SECRET=
IDP_GITHUB_CLIENT_ID=
IDP_GITHUB_CLIENT_SECRET=
IDP_GOOGLE_CLIENT_ID=
IDP_GOOGLE_CLIENT_SECRET=
IDP_GITLAB_CLIENT_ID=
IDP_GITLAB_CLIENT_SECRET=
